
flowchart TB

    USER["Users and Administrators"]

    subgraph ORG["AWS ORGANIZATION"]
        direction TB

        subgraph MGMT["Management Account"]
            IAM["AWS IAM<br/>Identity and Access Management"]
            SCP["Service Control Policies<br/>Organization-wide Restrictions"]
        end

        subgraph SEC["Security Account"]
            CT["AWS CloudTrail<br/>Centralized Audit Trail"]
            GD["Amazon GuardDuty<br/>Threat Detection"]
            CFG["AWS Config<br/>Configuration Monitoring"]
            KMS["AWS KMS<br/>Encryption Key Management"]
        end

        subgraph WORK["Workload Account"]
            APP["Protected Workloads<br/>EC2 and AWS Resources"]
            WROLE["IAM Roles<br/>Least-Privilege Access"]
        end
    end

    subgraph MON["CENTRALIZED SECURITY MONITORING"]
        LOG["Centralized Audit Logs"]
        ALERT["Security Findings and Alerts"]
        COM["Compliance Monitoring"]
    end

    USER --> IAM
    IAM --> WROLE
    IAM --> SCP
    SCP -. "Restricts permissions" .-> WORK

    WORK --> CT
    WORK --> GD
    WORK --> CFG

    CT --> LOG
    GD --> ALERT
    CFG --> COM

    KMS -. "Encrypts supported data" .-> LOG
    KMS -. "Key activity auditing" .-> CT

    classDef identity fill:#1e3a8a,color:#fff,stroke:#60a5fa
    classDef security fill:#713f12,color:#fff,stroke:#fbbf24
    classDef workload fill:#14532d,color:#fff,stroke:#4ade80
    classDef monitoring fill:#581c87,color:#fff,stroke:#c084fc

    class IAM,SCP identity
    class CT,GD,CFG,KMS security
    class APP,WROLE workload
    class LOG,ALERT,COM monitoring
